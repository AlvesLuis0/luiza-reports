<% head = { title: 'Conciliador' } %>

<h1 class="mb-4">Conciliador</h1>

<!-- modal de conciliação -->
<div id="conciliator-modal" class="modal fade" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-scrollable modal-dialog-centered modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h1 class="modal-title fs-5">Mudanças após conciliação</h1>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cancelar"></button>
      </div>
      <div class="modal-body">
        <table id="history-table" class="table table-striped">
          <thead>
            <tr>
              <th>Lancto</th>
              <th>Vencimento</th>
              <th>Valor anterior</th>
              <th>Valor posterior</th>
            </tr>
          </thead>
          <tbody></tbody>
        </table>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="button" class="btn btn-primary">Confirmar</button>
      </div>
    </div>
  </div>
</div>

<!-- conteúdo -->
<form action="/conciliator/import-extract" method="post" class="d-flex flex-column gap-3">
  <div class="row">
    <div class="col-4">
      <label for="files" class="required">Extratos no formato .ofx</label>
      <input name="files" id="files" type="file" accept=".ofx" multiple class="form-control" required>
    </div>
  </div>
</form>

<div class="row mt-3">
  <div class="col-1">
    <button id="action-btn" class="btn btn-success">Conciliar</button>
  </div>
</div>

<div class="row justify-content-between mt-3">
  <div class="col-6 fs-4">
    <span class="fw-bold">Total selecionado no contas a pagar:</span>
    <span id="selected-pending-total">R$ 0,00</span>
  </div>

  <div class="col-6 text-end fs-4">
    <span class="fw-bold">Total selecionado no extrato:</span>
    <span id="selected-extract-total">R$ 0,00</span>
  </div>
</div>

<div class="row my-3 mb-5">
  <div class="col border p-3">
    <h3 class="text-center">Contas a receber</h3>
    <table id="pending-transactions-table" class="table table-striped">
      <thead>
        <tr>
          <th>Código</th>
          <th>Nome</th>
          <th>Lancto</th>
          <th>Vencimento</th>
          <th>Valor</th>
        </tr>
      </thead>
      <tbody></tbody>
    </table>
  </div>

  <div class="col border p-3">
    <h3 class="text-center">Extrato</h3>
    <table id="extract-table" class="table table-striped">
      <thead>
        <tr>
          <th>Data</th>
          <th>Descrição</th>
          <th>Valor</th>
        </tr>
      </thead>
      <tbody></tbody>
    </table>
  </div>
</div>

<script src="/js/conciliator.js"></script>