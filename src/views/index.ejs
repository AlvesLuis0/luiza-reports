<% head = { title: 'Luiza Micro' } %>

<h1 class="mb-4">Todas as rotinas</h1>

<table id="routines-table" class="table table-striped">
  <thead>
    <tr>
      <th>Rotina</th>
      <th>Ações</th>
    </tr>
  </thead>

  <tbody>
    <% for(const routine of routines) { %>
      <tr>
        <td><%= routine.label %></td>
        <td><a href="<%= routine.path %>">Abrir</a></td>
      </tr>
    <% } %>
  </tbody>
</table>

<script>
  const table = new DataTable('#routines-table', { language: { url: '/i18n/datatables.json' } });
</script>